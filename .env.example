DISCORD_TOKEN=
ANTHROPIC_API_KEY=
# 개발 중에는 테스트 서버 ID를 넣으면 슬래시 커맨드가 즉시 반영됨
GUILD_ID=
CLAUDE_MODEL=claude-sonnet-5-5

# Notion (비워두면 로컬 JSON에만 저장)
NOTION_TOKEN=
# DB를 만들 페이지 URL 또는 ID — setup_notion.py에서만 사용
NOTION_PARENT_PAGE_ID=
# 아래 두 개는 setup_notion.py가 자동으로 채움
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=

# --- RAG / API (app/) ---
# 문서 소스: auto(Notion 설정 시 Notion, 아니면 data/history.jsonl) | notion | jsonl
RAG_SOURCE=auto
# 임베딩: openai | local
EMBEDDING_BACKEND=openai
OPENAI_API_KEY=
# /admin/sync-jobs 호출용 토큰
ADMIN_TOKEN=change-me
# 봇 -> API 서버 주소
POLICY_API_URL=http://localhost:8000
# 검색 결과 최소 점수 (엉뚱한 결과가 나오면 올리고, 결과가 너무 없으면 내리기)
RAG_MIN_SCORE=0.3

# --- 토큰 사용량 측정 (data/usage.jsonl) ---
# 단가: USD / 100만 토큰. 모델을 바꾸면 공식 가격표 보고 수정
PRICE_LLM_INPUT_PER_MTOK=3
PRICE_LLM_OUTPUT_PER_MTOK=15
PRICE_EMBED_PER_MTOK=0.02

# --- 외부 공개 시 필수 ---
# /policies/* 인증 키. 봇도 같은 값을 써서 호출한다. 예: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEY=
# 리랭킹 (평가 후 켬)
RERANK_ENABLED=false
# 하이브리드 검색: 벡터 + BM25 키워드 (리랭크 없이 쓸 때 효과 있음, README 측정 결과 참고)
HYBRID_ENABLED=false
# 정책서(NOTION_SPEC_PAGES)도 검색 인덱스에 넣기
SPEC_INDEX_ENABLED=true

# --- 사용량 제한 ---
# 사용자별 하루 멘션 질문 답변 횟수 (LLM을 실제로 부른 것만). 0 = 제한 없음
DAILY_ANSWER_LIMIT=30
# 월 예산 USD (요약·리랭크·답변·임베딩 합계). 0 = 예산 없음
MONTHLY_BUDGET_USD=0
BUDGET_ALERT_RATIO=0.8
BUDGET_HARD_STOP=true
# 예산 알림을 받을 Discord 웹훅 URL (채널 설정 → 연동 → 웹후크 → URL 복사)
BUDGET_ALERT_WEBHOOK_URL=

# --- 원천 정책서 반영 제안 (승인 후 기능명세서에 댓글·콜아웃) ---
# 기능영역=정책서 페이지 URL/ID (쉼표로 여러 개). "*=..."는 영역별 정책서가 없을 때 쓰는 기본 정책서. 비우면 반영 단계를 건너뜀
# 검색 인덱스에도 같은 값을 쓴다 (정책 ID 한 행 = 검색 문서 하나)
# 노션 통합에 '댓글 읽기·삽입' 권한(Capabilities → Comment)이 있어야 함
NOTION_SPEC_PAGES=
# 반영 제안을 낼 상태 (기본: 최종결정만)
SPEC_REFLECT_STATUSES=최종결정
# 제안 댓글에서 멘션할 노션 사용자 ID (PM, 쉼표로 여러 명). 비우면 멘션 없이 댓글만
NOTION_PM_USER_IDS=
# 매칭 모델 (비우면 CLAUDE_MODEL)
SPEC_MATCH_MODEL=
# 맞는 정책서를 못 찾은 제안을 모으는 페이지. python -m scripts.setup_spec_inbox 로 만들면 자동 기록. 비우면 디스코드에만 보고
NOTION_SPEC_INBOX_PAGE=
